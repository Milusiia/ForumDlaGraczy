@model ForumDlaGraczy.Models.EdycjaUzytkownikaModel

<div class="formularz-container">
    <div class="formularz-panel">

        <div class="formularz-naglowek">
            <h2><i class="fas fa-user-edit"></i> Edytowanie użytkownika</h2>
            <p>Możesz tutaj zmienić nazwę użytkownika oraz adres e-mail.</p>
        </div>

        <div asp-validation-summary="ModelOnly"></div>

        <form asp-controller="Uzytkownicy"
              asp-action="Edytuj"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="pole-formularza">
                <label asp-for="NazwaUzytkownika">Nazwa użytkownika</label>
                <input asp-for="NazwaUzytkownika" />
                <span asp-validation-for="NazwaUzytkownika"></span>
            </div>

            <div class="pole-formularza">
                <label asp-for="Email">Adres e-mail</label>
                <input asp-for="Email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="przyciski-formularza">
                <button type="submit" class="przycisk-dodaj">
                    <i class="fas fa-save"></i> Zapisz zmiany
                </button>

                <a asp-controller="Uzytkownicy"
                   asp-action="Index"
                   class="przycisk-wiadomosci">
                    <i class="fas fa-arrow-left"></i> Powrót do listy
                </a>
            </div>

        </form>

    </div>
</div>