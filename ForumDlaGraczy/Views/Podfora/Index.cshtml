@model IEnumerable<ForumDlaGraczy.Models.PodforumModel>

@{
    ViewData["Title"] = "Lista podforów";

    var nazwyKategorii =
        ViewBag.NazwyKategorii as Dictionary<int, string>;
}

<div class="formularz-container tabela-szeroka">
    <div class="formularz-panel">

        <div class="formularz-naglowek">
            <h2><i class="fa-solid fa-comments"></i> Lista podforów</h2>
            <p>Zarządzaj podforami i ustawieniami dostępu do nich.</p>
        </div>

        @if (TempData["Komunikat"] != null)
        {
            <div class="komunikat-formularza">
                @TempData["Komunikat"]
            </div>
        }

        <div class="przyciski-formularza">
            <a asp-controller="Podfora"
               asp-action="Dodaj"
               class="przycisk-dodaj">
                <i class="fa-solid fa-plus"></i>
                Dodaj nowe podforum
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="brak-wiadomosci">
                <i class="fa-solid fa-comments"></i>
                <p>Nie ma jeszcze żadnych podforów.</p>
            </div>
        }
        else
        {
            <div class="tabela-container">
                <table class="tabela-administracyjna">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nazwa podforum</th>
                            <th>Opis</th>
                            <th>Kategoria</th>
                            <th>Anonimowi mogą przeglądać</th>
                            <th>Anonimowi mogą pisać</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var podforum in Model)
                        {
                            var idKategorii = podforum.KategoriaForumId ?? 0;

                            var nazwaKategorii = "Nieznana kategoria";

                            if (nazwyKategorii != null &&
                                nazwyKategorii.ContainsKey(idKategorii))
                            {
                                nazwaKategorii = nazwyKategorii[idKategorii];
                            }

                            <tr>
                                <td>@podforum.Id</td>

                                <td class="tytul-watku">
                                    @podforum.Nazwa
                                </td>

                                <td class="tresc-wiadomosci">
                                    @podforum.Opis
                                </td>

                                <td>@nazwaKategorii</td>

                                <td>
                                    @if (podforum.CzyAnonimowiMogaOgladac)
                                    {
                                        <span style="color: #00ffa3;">Tak</span>
                                    }
                                    else
                                    {
                                        <span style="color: #ff6b6b;">Nie</span>
                                    }
                                </td>

                                <td>
                                    @if (podforum.CzyAnonimowiMogaPisac)
                                    {
                                        <span style="color: #00ffa3;">Tak</span>
                                    }
                                    else
                                    {
                                        <span style="color: #ff6b6b;">Nie</span>
                                    }
                                </td>

                                <td>
                                    <div class="akcje-wiadomosci">
                                        <a asp-controller="Podfora"
                                           asp-action="Edytuj"
                                           asp-route-id="@podforum.Id"
                                           class="przycisk-edytuj">
                                            <i class="fa-solid fa-pen"></i>
                                            Edytuj
                                        </a>

                                        <form asp-controller="Podfora"
                                              asp-action="Usun"
                                              asp-route-id="@podforum.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="przycisk-usun"
                                                    onclick="return confirm('Czy na pewno chcesz usunąć to podforum?')">
                                                <i class="fa-solid fa-trash"></i>
                                                Usuń
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="przyciski-formularza">
            <a asp-controller="PanelAdministracyjny"
               asp-action="Index"
               class="przycisk-wiadomosci">
                <i class="fa-solid fa-arrow-left"></i>
                Powrót do panelu administracyjnego
            </a>
        </div>

    </div>
</div>