@model IEnumerable<ForumDlaGraczy.Models.PodforumModel>

@{
    var nazwyKategorii = ViewBag.NazwyKategorii as Dictionary<int, string>;
}

<h2>Lista podforów</h2>

@if (TempData["Komunikat"] != null)
{
    <p>@TempData["Komunikat"]</p>
}

<p>
    <a asp-controller="Podfora" asp-action="Dodaj">
        Dodaj nowe podforum
    </a>
</p>

@if (!Model.Any())
{
    <p>Nie ma jeszcze żadnych podforów.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Nazwa podforum</th>
                <th>Opis</th>
                <th>Kategoria</th>
                <th>Anonimowi mogą przeglądać</th>
                <th>Anonimowi mogą pisać</th>
                <th>Akcje</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var podforum in Model)
            {
                var idKategorii = podforum.KategoriaForumId ?? 0;

                var nazwaKategorii = "Nieznana kategoria";

                if (nazwyKategorii != null &&
                    nazwyKategorii.ContainsKey(idKategorii))
                {
                    nazwaKategorii = nazwyKategorii[idKategorii];
                }

                <tr>
                    <td>@podforum.Id</td>

                    <td>@podforum.Nazwa</td>

                    <td>@podforum.Opis</td>

                    <td>@nazwaKategorii</td>

                    <td>
                        @(podforum.CzyAnonimowiMogaOgladac ? "Tak" : "Nie")
                    </td>

                    <td>
                        @(podforum.CzyAnonimowiMogaPisac ? "Tak" : "Nie")
                    </td>

                    <td>
                        <a asp-controller="Podfora"
                           asp-action="Edytuj"
                           asp-route-id="@podforum.Id">
                            Edytuj
                        </a>

                        |

                        <form asp-controller="Podfora"
                              asp-action="Usun"
                              asp-route-id="@podforum.Id"
                              method="post"
                              style="display:inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    onclick="return confirm('Czy na pewno chcesz usunąć to podforum?')">
                                Usuń
                            </button>

                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<br />

<a asp-controller="PanelAdministracyjny" asp-action="Index">
    Powrót do panelu administracyjnego
</a>