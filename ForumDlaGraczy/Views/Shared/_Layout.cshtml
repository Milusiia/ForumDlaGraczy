<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - PlayerZone</title>
    <script type="importmap"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/ForumDlaGraczy.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    </head>
<body>
<nav class="pasek-nawigacji">
    <div class="sekcja_menu">
        <div class="Logo">
            <a href="#" class="flex items-center gap-3">
                <i class="fa-solid fa-gamepad text-3xl logo-ikonka"></i>
                <span class="text-2xl font-bold text-white tracking-wider">
            Player<span class="logo-napis">Zone</span>
        </span>
            </a>
        </div>
        <div class="Ogłoszenia">
            Ogłoszenia
        </div>
        <div class="Turnieje">
            Turnieje
        </div>
        <div class="Ranking">
            Ranking
        </div>
    </div>

    <div class="wyszukiwanie">
        <input type="text" class="pole-wyszukiwania" placeholder="Szukaj gry, turnieju...">
    </div>
    
    <div class="sekcja_menu">
        <div class="Powiadomienia">
            <i class="fa-solid fa-bell"></i>
        </div>
        <div class="Logowanie">
            Zaloguj
        </div>
        <div class="Rejestracja">
            Załóż konto
        </div>
    </div>
</nav>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>