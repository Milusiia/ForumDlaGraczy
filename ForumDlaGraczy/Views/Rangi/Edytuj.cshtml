@model ForumDlaGraczy.Models.ZmianaRangiModel

<div class="formularz-container">
    <div class="formularz-panel">

        <div class="formularz-naglowek">
            <h2><i class="fas fa-user-shield"></i> Zmiana rangi użytkownika</h2>
            <p>Wybierz użytkownika i przypisz mu odpowiednią rangę.</p>
        </div>

        @if (ViewBag.Komunikat != null)
        {
            <div class="komunikat-formularza">
                @ViewBag.Komunikat
            </div>
        }

        <form asp-controller="Rangi" asp-action="Edytuj" method="post">

            <div asp-validation-summary="ModelOnly"></div>

            <div class="pole-formularza">
                <label asp-for="UzytkownikId">Użytkownik</label>

                <select asp-for="UzytkownikId" asp-items="ViewBag.Uzytkownicy">
                    <option value="">-- Wybierz użytkownika --</option>
                </select>

                <span asp-validation-for="UzytkownikId"></span>
            </div>

            <div class="pole-formularza">
                <label asp-for="Ranga">Ranga</label>

                <select asp-for="Ranga" asp-items="ViewBag.Rangi">
                    <option value="">-- Wybierz rangę --</option>
                </select>

                <span asp-validation-for="Ranga"></span>
            </div>

            <div class="przyciski-formularza">
                <button type="submit" class="przycisk-dodaj">
                    <i class="fas fa-save"></i> Zmień rangę
                </button>

                <a asp-controller="PanelAdministracyjny"
                   asp-action="Index"
                   class="przycisk-wiadomosci">
                    <i class="fas fa-arrow-left"></i> Powrót do panelu
                </a>
            </div>

        </form>

    </div>
</div>