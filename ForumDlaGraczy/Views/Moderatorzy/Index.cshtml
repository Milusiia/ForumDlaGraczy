@model IEnumerable<ForumDlaGraczy.Models.PrzypisanieModeratoraModel>

@{
    var nazwyUzytkownikow =
        ViewBag.NazwyUzytkownikow as Dictionary<int, string>;

    var nazwyPodforow =
        ViewBag.NazwyPodforow as Dictionary<int, string>;
}

<h2>Lista moderatorów</h2>

@if (TempData["Komunikat"] != null)
{
    <p>@TempData["Komunikat"]</p>
}

<p>
    <a asp-controller="Moderatorzy" asp-action="Dodaj">
        Przypisz nowego moderatora
    </a>
</p>

@if (!Model.Any())
{
    <p>Nie ma jeszcze żadnych przypisanych moderatorów.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Użytkownik</th>
                <th>Podforum</th>
                <th>Akcje</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var przypisanie in Model)
            {
                var idUzytkownika = przypisanie.UzytkownikId ?? 0;
                var idPodforum = przypisanie.PodforumId ?? 0;

                var nazwaUzytkownika = "Nieznany użytkownik";
                var nazwaPodforum = "Nieznane podforum";

                if (nazwyUzytkownikow != null &&
                    nazwyUzytkownikow.ContainsKey(idUzytkownika))
                {
                    nazwaUzytkownika = nazwyUzytkownikow[idUzytkownika];
                }

                if (nazwyPodforow != null &&
                    nazwyPodforow.ContainsKey(idPodforum))
                {
                    nazwaPodforum = nazwyPodforow[idPodforum];
                }

                <tr>
                    <td>@przypisanie.Id</td>
                    <td>@nazwaUzytkownika</td>
                    <td>@nazwaPodforum</td>

                    <td>
                        <form asp-controller="Moderatorzy"
                              asp-action="Usun"
                              asp-route-id="@przypisanie.Id"
                              method="post"
                              style="display:inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    onclick="return confirm('Czy na pewno chcesz odebrać uprawnienia tego moderatora?')">
                                Odbierz uprawnienia
                            </button>

                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}