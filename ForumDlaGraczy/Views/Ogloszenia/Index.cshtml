@model IEnumerable<ForumDlaGraczy.Models.OgloszenieModel>

@{
    ViewData["Title"] = "Lista ogłoszeń";
}

<div class="formularz-container tabela-szeroka">
    <div class="formularz-panel">

        <div class="formularz-naglowek">
            <h2>Lista ogłoszeń</h2>
            <p>Zarządzaj ogłoszeniami wyświetlanymi na forum.</p>
        </div>

        @if (TempData["Komunikat"] != null)
        {
            <div class="komunikat-formularza">
                @TempData["Komunikat"]
            </div>
        }

        <div class="przyciski-formularza">
            <a asp-controller="Ogloszenia"
               asp-action="Dodaj"
               class="przycisk-dodaj">
                <i class="fa-solid fa-plus"></i>
                Dodaj nowe ogłoszenie
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="brak-wiadomosci">
                <i class="fa-solid fa-bullhorn"></i>
                <p>Nie ma jeszcze żadnych ogłoszeń.</p>
            </div>
        }
        else
        {
            <div class="tabela-container">
                <table class="tabela-administracyjna">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tytuł</th>
                            <th>Treść</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var ogloszenie in Model)
                        {
                            <tr>
                                <td>@ogloszenie.Id</td>

                                <td class="tytul-watku">
                                    @ogloszenie.Tytul
                                </td>

                                <td class="tresc-wiadomosci">
                                    @ogloszenie.Tresc
                                </td>

                                <td>
                                    <div class="akcje-wiadomosci">
                                        <a asp-controller="Ogloszenia"
                                           asp-action="Edytuj"
                                           asp-route-id="@ogloszenie.Id"
                                           class="przycisk-edytuj">
                                            <i class="fa-solid fa-pen"></i>
                                            Edytuj
                                        </a>

                                        <form asp-controller="Ogloszenia"
                                              asp-action="Usun"
                                              asp-route-id="@ogloszenie.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="przycisk-usun"
                                                    onclick="return confirm('Czy na pewno chcesz usunąć to ogłoszenie?')">
                                                <i class="fa-solid fa-trash"></i>
                                                Usuń
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>