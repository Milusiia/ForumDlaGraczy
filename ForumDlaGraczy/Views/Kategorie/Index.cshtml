@model IEnumerable<ForumDlaGraczy.Models.KategoriaForumModel>

<h2>Lista kategorii forum</h2>

@if (TempData["Komunikat"] != null)
{
    <p>@TempData["Komunikat"]</p>
}

<p>
    <a asp-controller="Kategorie" asp-action="Dodaj">
        Dodaj nową kategorię
    </a>
</p>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nazwa kategorii</th>
            <th>Opis kategorii</th>
            <th>Akcje</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var kategoria in Model)
        {
            <tr>
                <td>@kategoria.Id</td>
                <td>@kategoria.Nazwa</td>
                <td>@kategoria.Opis</td>

                <td>
                    <a asp-controller="Kategorie"
                       asp-action="Edytuj"
                       asp-route-id="@kategoria.Id">
                        Edytuj
                    </a>

                    <form asp-controller="Kategorie"
                          asp-action="Usun"
                          asp-route-id="@kategoria.Id"
                          method="post"
                          style="display:inline">

                        <button type="submit">Usuń</button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>