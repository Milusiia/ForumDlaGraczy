@model ForumDlaGraczy.Models.StatystykiForumModel

<div class="formularz-container">
    <div class="formularz-panel panel-administracyjny">

        <div class="formularz-naglowek">
            <h2><i class="fas fa-chart-line"></i> Statystyki forum</h2>
            <p>Podsumowanie aktywności na forum dla graczy.</p>
        </div>

        <div class="kafelki-panelu">

            <div class="kafelek-panelu">
                <i class="fas fa-users"></i>
                <span>
                    Liczba użytkowników
                    <br />
                    <strong>@Model.LiczbaUzytkownikow</strong>
                </span>
            </div>

            <div class="kafelek-panelu">
                <i class="fas fa-comments"></i>
                <span>
                    Liczba wątków
                    <br />
                    <strong>@Model.LiczbaWatkow</strong>
                </span>
            </div>

            <div class="kafelek-panelu">
                <i class="fas fa-reply-all"></i>
                <span>
                    Liczba odpowiedzi
                    <br />
                    <strong>@Model.LiczbaOdpowiedzi</strong>
                </span>
            </div>

            <div class="kafelek-panelu">
                <i class="fas fa-folder"></i>
                <span>
                    Liczba kategorii
                    <br />
                    <strong>@Model.LiczbaKategorii</strong>
                </span>
            </div>

            <div class="kafelek-panelu">
                <i class="fas fa-layer-group"></i>
                <span>
                    Liczba podforów
                    <br />
                    <strong>@Model.LiczbaPodforow</strong>
                </span>
            </div>

            <div class="kafelek-panelu">
                <i class="fas fa-eye"></i>
                <span>
                    Łączna liczba odsłon
                    <br />
                    <strong>@Model.LiczbaOdslon</strong>
                </span>
            </div>

        </div>

        <div class="przyciski-formularza">
            <a asp-controller="PanelAdministracyjny"
               asp-action="Index"
               class="przycisk-wiadomosci">
                <i class="fas fa-arrow-left"></i> Powrót do panelu administracyjnego
            </a>
        </div>

    </div>
</div>