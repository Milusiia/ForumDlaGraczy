@{
    ViewData["Title"] = "Panel administracyjny";
}

<div class="formularz-container panel-administracyjny">

    <div class="formularz-panel">

        <div class="formularz-naglowek">
            <h2><i class="fa-solid fa-shield-halved"></i> Panel administracyjny</h2>
            <p>Witaj w panelu administracyjnym forum dla graczy!</p>
        </div>

        <div class="sekcja-panelu">
            <h3><i class="fa-solid fa-gears"></i> Zarządzanie forum</h3>

            <div class="kafelki-panelu">
                <a asp-controller="Kategorie" asp-action="Index" class="kafelek-panelu">
                    <i class="fa-solid fa-folder"></i>
                    <span>Zarządzanie kategoriami</span>
                </a>

                <a asp-controller="Podfora" asp-action="Index" class="kafelek-panelu">
                    <i class="fa-solid fa-comments"></i>
                    <span>Zarządzanie podforami</span>
                </a>

                <a asp-controller="Ogloszenia" asp-action="Index" class="kafelek-panelu">
                    <i class="fa-solid fa-bullhorn"></i>
                    <span>Zarządzanie ogłoszeniami</span>
                </a>

                <a asp-controller="Moderatorzy" asp-action="Index" class="kafelek-panelu">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Zarządzanie moderatorami</span>
                </a>

                <a asp-controller="Statystyki" asp-action="Index" class="kafelek-panelu">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Statystyki forum</span>
                </a>

                <a asp-controller="AdministracjaTresci" asp-action="Index" class="kafelek-panelu">
                    <i class="fa-solid fa-file-lines"></i>
                    <span>Zarządzanie wątkami i wiadomościami</span>
                </a>
            </div>
        </div>

        <div class="sekcja-panelu">
            <h3><i class="fa-solid fa-gavel"></i> Moderacja</h3>

            <div class="kafelki-panelu">
                <a asp-controller="Zgloszenia" asp-action="Index" class="kafelek-panelu">
                    <i class="fa-solid fa-flag"></i>
                    <span>Zgłoszenia wiadomości</span>
                </a>

                <a asp-controller="PrzypieciaWatkow" asp-action="Edytuj" class="kafelek-panelu">
                    <i class="fa-solid fa-thumbtack"></i>
                    <span>Przypinanie wątków</span>
                </a>
            </div>
        </div>

        <div class="sekcja-panelu">
            <h3><i class="fa-solid fa-users"></i> Użytkownicy</h3>

            <div class="kafelki-panelu">
                <a asp-controller="Uzytkownicy" asp-action="Index" class="kafelek-panelu">
                    <i class="fa-solid fa-user-group"></i>
                    <span>Zarządzanie użytkownikami</span>
                </a>

                <a asp-controller="Rangi" asp-action="Edytuj" class="kafelek-panelu">
                    <i class="fa-solid fa-medal"></i>
                    <span>Zarządzanie rangami</span>
                </a>
            </div>
        </div>

    </div>
</div>