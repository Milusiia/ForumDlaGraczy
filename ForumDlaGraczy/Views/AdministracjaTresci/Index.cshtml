@model IEnumerable<ForumDlaGraczy.Models.WatekAdministracyjnyModel>

@{
    ViewData["Title"] = "Zarządzanie wątkami";
}

<div class="zarzadzanie-container">

    <div class="zarzadzanie-panel">

        <div class="zarzadzanie-naglowek">
            <i class="fa-solid fa-comments"></i>
            <h2>Zarządzanie wątkami</h2>
            <p>Przeglądaj wątki i sprawdzaj aktywność użytkowników forum.</p>
        </div>

        <div class="tabela-container">

            <table class="tabela-administracyjna">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tytuł wątku</th>
                        <th>Autor</th>
                        <th>Forum</th>
                        <th>Data utworzenia</th>
                        <th>Odsłony</th>
                        <th>Odpowiedzi</th>
                        <th>Przypięty</th>
                        <th>Akcje</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var watek in Model)
                    {
                        <tr>
                            <td>@watek.Id</td>

                            <td class="tytul-watku">
                                @watek.Tytul
                            </td>

                            <td>@watek.Autor</td>

                            <td>@watek.Podforum</td>

                            <td class="data-watku">
                                @watek.DataUtworzenia.ToString("dd.MM.yyyy")
                            </td>

                            <td>@watek.LiczbaOdslon</td>

                            <td>@watek.LiczbaOdpowiedzi</td>

                            <td>
                                @if (watek.CzyPrzypiety)
                                {
                                    <span class="status-przypiety">Tak</span>
                                }
                                else
                                {
                                    <span class="status-nieprzypiety">Nie</span>
                                }
                            </td>

                            <td>
                                <a asp-controller="AdministracjaTresci"
                                   asp-action="Wiadomosci"
                                   asp-route-id="@watek.Id"
                                   class="przycisk-wiadomosci">

                                    <i class="fa-solid fa-eye"></i>
                                    Wiadomości

                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <div class="powrot-administracja">
            <a asp-controller="PanelAdministracyjny"
               asp-action="Index">

                <i class="fa-solid fa-arrow-left"></i>
                Powrót do panelu administracyjnego

            </a>
        </div>

    </div>

</div>