@model ForumDlaGraczy.Models.WiadomoscAdministracyjnaModel

@{
    ViewData["Title"] = "Edytowanie wiadomości";
}

<div class="formularz-container">

    <div class="formularz-panel">

        <div class="formularz-naglowek">
            <i class="fa-solid fa-user-shield"></i>
            <h2>Edytowanie wiadomości</h2>
            <p>Edytuj treść wiadomości opublikowanej na forum.</p>
        </div>

        <div asp-validation-summary="ModelOnly"></div>

        <div class="komunikat-formularza">
            <p>
                <strong>Wątek:</strong> @Model.TytulWatku
            </p>
            <p>
                <strong>Autor wiadomości:</strong> @Model.Autor
            </p>
        </div>

        <form asp-controller="AdministracjaTresci"
              asp-action="EdytujWiadomosc"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="pole-formularza">
                <label asp-for="Tresc">Treść wiadomości</label>

                <textarea asp-for="Tresc"
                          rows="6"
                          placeholder="Wpisz treść wiadomości..."></textarea>

                <span asp-validation-for="Tresc"></span>
            </div>

            <div class="przyciski-formularza">
                <button type="submit" class="przycisk-dodaj">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Zapisz zmiany
                </button>
            </div>

        </form>

        <div style="text-align: center; margin-top: 25px;">
            <a asp-controller="AdministracjaTresci"
               asp-action="Wiadomosci"
               asp-route-id="@Model.WatekId"
               style="color: #00ffa3; text-decoration: none;">

                <i class="fa-solid fa-arrow-left"></i>
                Powrót do wiadomości

            </a>
        </div>

    </div>

</div>