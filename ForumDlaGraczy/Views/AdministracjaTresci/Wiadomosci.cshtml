@model IEnumerable<ForumDlaGraczy.Models.WiadomoscAdministracyjnaModel>

@{
    ViewData["Title"] = "Wiadomości w wątku";
    var watek = ViewBag.Watek as ForumDlaGraczy.Models.WatekAdministracyjnyModel;
}

<div class="zarzadzanie-container">

    <div class="zarzadzanie-panel">

        <div class="zarzadzanie-naglowek">
            <i class="fa-solid fa-comments"></i>
            <h2>Wiadomości w wątku</h2>
            <p>Przeglądaj, edytuj i usuwaj wiadomości użytkowników.</p>
        </div>

        @if (TempData["Komunikat"] != null)
        {
            <div class="komunikat-formularza">
                @TempData["Komunikat"]
            </div>
        }

        @if (watek != null)
        {
            <div class="informacje-watku">
                <h3>@watek.Tytul</h3>

                <p>
                    <i class="fa-solid fa-user"></i>
                    <strong>Autor wątku:</strong> @watek.Autor
                </p>

                <p>
                    <i class="fa-solid fa-folder"></i>
                    <strong>Forum:</strong> @watek.Podforum
                </p>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="brak-wiadomosci">
                <i class="fa-solid fa-comment-slash"></i>
                <p>Ten wątek nie ma jeszcze żadnych odpowiedzi.</p>
            </div>
        }
        else
        {
            <div class="tabela-container">

                <table class="tabela-administracyjna">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Autor</th>
                            <th>Treść wiadomości</th>
                            <th>Data</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var wiadomosc in Model)
                        {
                            <tr>
                                <td>@wiadomosc.Id</td>

                                <td>@wiadomosc.Autor</td>

                                <td class="tresc-wiadomosci">
                                    @wiadomosc.Tresc
                                </td>

                                <td>
                                    @wiadomosc.DataUtworzenia.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    <div class="akcje-wiadomosci">

                                        <a asp-controller="AdministracjaTresci"
                                           asp-action="EdytujWiadomosc"
                                           asp-route-id="@wiadomosc.Id"
                                           class="przycisk-edytuj">

                                            <i class="fa-solid fa-pen"></i>
                                            Edytuj

                                        </a>

                                        <form asp-controller="AdministracjaTresci"
                                              asp-action="UsunWiadomosc"
                                              asp-route-id="@wiadomosc.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="przycisk-usun"
                                                    onclick="return confirm('Czy na pewno chcesz usunąć tę wiadomość?')">

                                                <i class="fa-solid fa-trash"></i>
                                                Usuń

                                            </button>

                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

        <div class="powrot-administracja">
            <a asp-controller="AdministracjaTresci"
               asp-action="Index">

                <i class="fa-solid fa-arrow-left"></i>
                Powrót do listy wątków

            </a>
        </div>

    </div>

</div>